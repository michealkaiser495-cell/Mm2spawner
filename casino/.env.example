# Copy to .env and fill in. Never commit .env.

PORT=3000
# Public URL of the site. Used for Stripe redirect URLs. https:// turns on Secure cookies.
BASE_URL=http://localhost:3000
SITE_NAME=Neon Vault

# Stripe: use test keys (sk_test_...) until you are licensed and approved by Stripe for gambling.
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
CURRENCY=usd

# All amounts are in cents.
SIGNUP_BONUS_CENTS=1000
MIN_DEPOSIT_CENTS=500
MAX_DEPOSIT_CENTS=50000
DAILY_DEPOSIT_LIMIT_CENTS=100000

# Path to the SQLite database file.
DATABASE_PATH=./data/casino.db

# Withdrawals: players are told to DM this Discord user with their request ID.
DISCORD_CONTACT=wmz9
MIN_WITHDRAW_CENTS=1000
# Comma-separated usernames that can open #/admin and approve or reject withdrawals.
ADMIN_USERNAMES=

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx, etc.) so rate limits see real IPs.
TRUST_PROXY=0
